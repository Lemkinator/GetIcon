{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":disableDependencyDashboard",
    ":renovatePrefix",
    ":configMigration"
  ],
  "platformAutomerge": true,
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "digest"
      ],
      "matchCurrentVersion": "!/^0/",
      "automerge": true
    },
    {
      "groupName": "kotlin",
      "matchPackageNames": [
        "org.jetbrains.kotlin:**",
        "org.jetbrains.kotlin.*:**",
        "com.google.devtools.ksp**"
      ]
    },
    {
      "groupName": "hilt",
      "matchPackageNames": [
        "com.google.dagger**"
      ]
    },
    {
      "groupName": "androidx-test",
      "matchPackageNames": [
        "androidx.test**"
      ]
    },
    {
      "groupName": "kotest",
      "matchPackageNames": [
        "io.kotest**",
        "de.mannodermaus.android-junit**"
      ]
    },
    {
      "groupName": "junit5",
      "matchPackageNames": [
        "org.junit.jupiter:**",
        "org.junit.platform:**",
        "org.junit.vintage:**"
      ]
    },
    {
      "groupName": "screenshot-testing",
      "matchPackageNames": [
        "io.github.takahirom.roborazzi**",
        "org.robolectric:**"
      ]
    },
    {
      "matchPackageNames": [
        "org.robolectric:robolectric"
      ],
      "prBodyNotes": [
        "A Robolectric bump can need new `robolectric-android-all-<api>` coordinates in `gradle/libs.versions.toml`. If `local-tests` fails with `Path is not a file`, follow the \"Robolectric jars\" section in CLAUDE.md."
      ]
    },
    {
      "matchPackageNames": [
        "org.robolectric:android-all-instrumented"
      ],
      "enabled": false
    },
    {
      "groupName": "github-actions",
      "matchManagers": [
        "github-actions"
      ]
    },
    {
      "groupName": "static-analysis",
      "matchPackageNames": [
        "dev.detekt**",
        "io.gitlab.arturbosch.detekt**",
        "com.diffplug.spotless**"
      ]
    }
  ]
}
